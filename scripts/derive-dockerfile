#!/usr/bin/env bash
# Generate a derived runner Dockerfile from a declarative .github/runner-image.yml.
#
# Usage: scripts/derive-dockerfile <config.yml>
# Writes the derived Dockerfile to stdout.
#
# The declarative config supports:
#   base: docker.io/jrepp/runner-base:1.0.0        # base image (required)
#   toolchains:
#     go: 1.27.1                                    # override go
#     node: 26.7.0                                  # override node
#     python: 3.14.7                                # override uv python
#     rust: 1.88.0                                  # rustup toolchain + default
#   apt:
#     packages: [imagemagick]                       # extra system packages
#
# Projects that need more than this should use the Dockerfile escape hatch
# instead: FROM docker.io/jrepp/runner-base:<tag> and their own RUN steps.
set -euo pipefail

config="${1:-.github/runner-image.yml}"

if ! command -v yq >/dev/null 2>&1; then
  echo "yq is required to render derived runner images" >&2
  exit 1
fi

base="$(yq -r '.base // ""' "${config}")"
if [[ -z "${base}" ]]; then
  echo "runner-image.yml must set 'base'" >&2
  exit 1
fi

cat <<EOF
# Generated by scripts/derive-dockerfile from ${config}. Do not edit by hand.
FROM ${base}

EOF

packages="$(yq -r '.apt.packages[]? // ""' "${config}")"
if [[ -n "${packages}" ]]; then
  printf 'RUN apt-get update && apt-get install -y --no-install-recommends %s && rm -rf /var/lib/apt/lists/*\n' \
    "${packages//$'\n'/ }"
fi

go="$(yq -r '.toolchains.go // ""' "${config}")"
if [[ -n "${go}" ]]; then
  cat <<EOF
RUN set -eux; \
    curl -fsSL "https://go.dev/dl/go${go}.linux-amd64.tar.gz" -o /tmp/go.tgz; \
    rm -rf /usr/local/go; \
    tar -C /usr/local -xzf /tmp/go.tgz; \
    rm /tmp/go.tgz

EOF
fi

node="$(yq -r '.toolchains.node // ""' "${config}")"
if [[ -n "${node}" ]]; then
  cat <<EOF
RUN set -eux; \
    curl -fsSL "https://nodejs.org/dist/v${node}/node-v${node}-linux-x64.tar.xz" -o /tmp/node.tar.xz; \
    rm -rf /opt/node; \
    mkdir -p /opt/node; \
    tar -C /opt/node -xJf /tmp/node.tar.xz --strip-components=1; \
    rm /tmp/node.tar.xz

EOF
fi

python="$(yq -r '.toolchains.python // ""' "${config}")"
if [[ -n "${python}" ]]; then
  cat <<EOF
RUN set -eux; \
    uv python install "${python}"; \
    PYBIN="\$(dirname "\$(uv python find "${python}")")"; \
    ln -sf "\${PYBIN}/python3" /usr/local/bin/python3; \
    ln -sf "\${PYBIN}/python3" /usr/local/bin/python; \
    ln -sf "\${PYBIN}/pip3" /usr/local/bin/pip; \
    ln -sf "\${PYBIN}/pip3" /usr/local/bin/pip3

EOF
fi

rust="$(yq -r '.toolchains.rust // ""' "${config}")"
if [[ -n "${rust}" ]]; then
  cat <<EOF
RUN rustup toolchain install "${rust}" && rustup default "${rust}"

EOF
fi
